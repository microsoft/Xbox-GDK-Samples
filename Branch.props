<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup>
    <!-- Set up the BranchRoot property if it is not already set up -->
    <BranchRoot Condition="'$(BranchRoot)' == ''">$(MSBuildThisFileDirectory)</BranchRoot>
    <ExtractedSDKRoot Condition="'$(ExtractedSDKRoot)' == ''">$([System.IO.Path]::GetPathRoot($(BranchRoot)))xtrctd.sdks\</ExtractedSDKRoot>
  </PropertyGroup>

  <!--
  ************************************************************************************************************************
  GDK Version Resolution
  
  GXDK Spec entries and version information are dynamically discovered from:
    \\edge-svcs\drops\greensignedpackages
  
  Two files are generated by Scripts\Resolve-GdkVersion.ps1:
    - GdkVersions.g.props       : latest GA/LKG version properties
    - GdkVersions.Specs.g.props : GXDK Spec entries for all discovered versions
  
  In pipelines, the script runs as a pre-build step. Locally, CreateATGShortcut
  generates on demand, or run manually:
    powershell -File Scripts\Resolve-GdkVersion.ps1

  Latest GA is determined by the highest XDKEditionTarget among released GDK
  folders (newest release series wins). Latest LKG is resolved from the
  _Latest_Developer_LKG shortcut.
  ************************************************************************************************************************
  -->

  <!-- Import dynamically discovered latest version markers (GdkLatestGA_Version, GdkLatestLKG_Version) -->
  <Import Project="$(MSBuildThisFileDirectory)Infrastructure\Build\GdkVersions.g.props"
          Condition="Exists('$(MSBuildThisFileDirectory)Infrastructure\Build\GdkVersions.g.props')" />


  <!--
  ========================================================================
  LEGACY REFERENCE (preserved for historical context)
  
  The GXDK Spec entries below were previously maintained manually.
  Active version resolution is now handled dynamically by
  GdkVersions.g.props (auto-generated from edge-svcs).
  
  Note: Double-dashes in the original content have been escaped as
  "- -" to comply with XML comment syntax.
  ========================================================================
    <!- -
    ************************************************************************************************************************
    Where to find SDKs and Recoveries:
    1.	Windows SDK
        a.        Branch = GE_RELEASE
        b.        Build = \\winbuilds\release\ge_release_svc_prod3\26100.7705.260126-1049\other\kit_bundles\windowssdk
        c.        Green = \\edge-svcs\drops\greensignedpackages\Windows_SDK\26100
  
    2.	Microsoft GDK
        a.        Branch = XB_GDK_24??NI
        b.        Build = \\winbuilds\release\XB_GDK_24??NI\<VERSION>\Other\kit_bundles\
        c.        Green = \\edge-svcs\drops\greensignedpackages\xb_gdk_24?ni_daily
  
    3.	Xbox Recovery
        a.        Branch = XB_FLT_24??NI
        b.        Build = \\winbuilds\release\XB_FLT_24??CO\<VERSION>\amd64fre\xbgreen_recovery
        c.        Green = \\edge-svcs\drops\greensignedpackages\xb_flt_24??ni_daily
  
    For current builds, see:
        \\edge-svcs\drops\greensignedpackages\_Latest_Developer_LKG
        \\edge-svcs\drops\greensignedpackages\__Latest_Public_Release
    ************************************************************************************************************************
    - ->
  
    <!- -
    ************************************************************************************************************************
    How to create a GXDK Spec:
        The following sequence of PropertyGroups define the key properties for the ATG Build Environment
        Use the CreateATGShortcut located in the same folder as this file to create a desktop shortcut
        for an ATG Command Prompt that is configured to build according to the parameters in one of the
        "GXDK Spec" property groups.
  
        REQUIRED:
        - To be visible to the CreateATGShortcut tool you must include the Label="GXDK Spec"
          AND the Condition attribute must have the following form:
          '$(GXDK_VERSION)' == 'XXXXX.XXXX.XXXXXX-XXXX'
        - You must have a definition for the <XDKEditionTarget> property
        - You must have a definition for the <WindowsSDKVersion> property
  
        OPTIONAL:
        - You may specify the <GXDKBuildShare> or <GXDKInstallersFolder> property
        - You may specify the <WindowsSDKBuildShare> or <WindowsSDKInstallersFolder> property
        - You may specify either true or false the <GXDKGreenSigned> property. This will control
          whether the .msi files are pulled from gdk_green vs. gdk
  
          ADDITIONAL OVERRIDE OPTIONS:
          - Sometimes the location of the Installers folder for a particular GXDK and/or Windows SDK does
            not conform to the usual pattern (e.g. <build share>\other\kit_bundles\gdk_green\Installers\)
            In this case you can override the <GXDKInstallersFolder> and/or <WindowsSDKInstallersFolder>
            property(ies) to specify the location of the .cab and .msi files directly and unambiguously
  
    See Also: The PropertyGroup after the "DEFAULTS" banner comment specifies default values for:
        <GXDKBuildShare>, <GXDKGreenSigned>, and <WindowsSDKBuildShare>
    ************************************************************************************************************************
    - ->
  
