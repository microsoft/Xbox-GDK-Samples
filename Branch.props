  <!--
  The following property groups will define the value of GXDK_VERSION to use for various server build types

  See also http://aka.ms/gdkapprovedlibs
  -->
  <!-- Override: use LKG version on any build type when OVERRIDE_TO_LKG pipeline variable is set -->
  <PropertyGroup Condition="'$(OVERRIDE_TO_LKG)' == 'true'">
    <GXDK_VERSION Condition="'$(GXDK_VERSION)' == ''">$(GdkLatestLKG_Version)</GXDK_VERSION>
    <SkipXVDDeploy>true</SkipXVDDeploy>
  </PropertyGroup>

  <PropertyGroup Condition="'$(SERVER_BUILD_TYPE)' == 'Nightly' OR '$(SERVER_BUILD_TYPE)' == 'CI' OR '$(SERVER_BUILD_TYPE)' == 'Publish'" >
    <GXDK_VERSION Condition="'$(GXDK_VERSION)' == ''">$(GdkLatestGA_Version)</GXDK_VERSION> <!-- Dynamically resolved latest GA -->
    <SkipXVDDeploy>true</SkipXVDDeploy>
  </PropertyGroup>

  <PropertyGroup Condition="'$(SERVER_BUILD_TYPE)' == 'ClangLLVM'" >
    <GXDK_VERSION Condition="'$(GXDK_VERSION)' == ''">$(GdkLatestGA_Version)</GXDK_VERSION> <!-- Dynamically resolved latest GA -->
    <SkipXVDDeploy>true</SkipXVDDeploy>
  </PropertyGroup>

  <PropertyGroup Condition="'$(SERVER_BUILD_TYPE)' == 'Prerelease'" >
    <GXDK_VERSION Condition="'$(GXDK_VERSION)' == ''">$(GdkLatestLKG_Version)</GXDK_VERSION> <!-- Dynamically resolved latest LKG -->
    <SkipXVDDeploy>true</SkipXVDDeploy>
  </PropertyGroup>

  <!-- Import GXDK Spec entries AFTER GXDK_VERSION is set so conditions can match -->
  <Import Project="$(MSBuildThisFileDirectory)Infrastructure\Build\GdkVersions.Specs.g.props"
          Condition="Exists('$(MSBuildThisFileDirectory)Infrastructure\Build\GdkVersions.Specs.g.props')" />

  <!--
  ************************************************************************************************************************
  DEFAULTS
  ********

  !!! IMPORTANT !!!
     if you change the defaults then you should revisit all the "GXDK Spec"s and make sure that they have correct values
     explicitly specified for: <GXDKBuildShare>, <GXDKGreenSigned>, and <WindowsSDKBuildShare>
  ************************************************************************************************************************
  -->

  <!-- These property groups must appear after all the GXDK Specs -->
  <PropertyGroup>
    <ExtractedFolder Condition="'$(ExtractedFolder)' == ''">$(ExtractedSDKRoot)$(GXDK_VERSION)\</ExtractedFolder>
    <ExtractedFolder Condition="!HasTrailingSlash('$(ExtractedFolder)')">$(ExtractedFolder)\</ExtractedFolder>

    <!-- Defaults for these properties can be overridden in the preceding GXDK Spec -->
    <GXDKBuildShare Condition="'$(GXDKBuildShare)' == ''">\\winbuilds\release\XB_GDK_2208NI\$(GXDK_VERSION)\</GXDKBuildShare>
    <WindowsSDKBuildShare Condition="'$(WindowsSDKBuildShare)' == ''">\\winbuilds\release\co_release_svc_prod1\</WindowsSDKBuildShare>
    <GXDKGreenSigned Condition="'$(GXDKGreenSigned)' == ''">true</GXDKGreenSigned>
  </PropertyGroup>

  <!-- The following import sets up all the properties needed for building against the extracted GXDK and WindowsSDK -->
  <Import Project="Gaming.build.props"/>

</Project>
