<?xml version="1.0" encoding="utf-8"?>
<Game configVersion="0">
  <!-- Version "1" is supported by March 2022 GDK or later -->

  <Identity Name="bb5f071e-74ee-4bd0-9a34-0833134aefe0"
            Publisher="CN=Microsoft Corporation, O=Microsoft Corporation, L=Redmond, S=Washington, C=US"
            Version="1.0.0.0"/>

  <ExecutableList>
    <Executable Name="GpuBench.exe"
                Id="Game"/>
  </ExecutableList>

  <ShellVisuals DefaultDisplayName="GpuBench"
                PublisherDisplayName="Xbox Advanced Technology Group"
                StoreLogo="Assets\StoreLogo.png"
                Square150x150Logo="Assets\Logo.png"
                Square44x44Logo="Assets\SmallLogo.png"
                Square480x480Logo="Assets\LargeLogo.png"
                Description="GpuBench"
                ForegroundText="dark"
                BackgroundColor="#000000"
                SplashScreenImage="Assets\SplashScreen.png"/>

  <PersistentLocalStorage>
    <SizeMB>12888</SizeMB>
  </PersistentLocalStorage>

  <VirtualMachine>
    <XboxOneXTitleMemory>Advanced</XboxOneXTitleMemory>
  </VirtualMachine>

  <MediaCapture>
    <BlockGameDVR>true</BlockGameDVR>
    <BlockBroadcast>true</BlockBroadcast>
  </MediaCapture>
</Game>
