                    "focusedStyleId": "Slider_Focused_Button_Style",
                    "hoveredStyleId": "Slider_Hovered_Button_Style",
                    "pressedStyleId": "Slider_Pressed_Button_Style",
                    "disabledStyleId": "Slider_Disabled_Button_Style"
