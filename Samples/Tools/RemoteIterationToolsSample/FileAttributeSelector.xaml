<UserControl x:Class="RemoteIterationToolsSample.FileAttributeSelector"
             x:Name="Selector"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
    <GroupBox Header="{Binding Label, ElementName=Selector}" Foreground="White"
              BorderThickness="0" Padding="0" Margin="0 4 0 8">
        <WrapPanel>
            <WrapPanel.Resources>
                <Style TargetType="CheckBox">
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Margin" Value="0 4 16 4"/>
                    <Setter Property="IsChecked" Value="False"/>
                    <Setter Property="IsThreeState" Value="False"/>
                </Style>
            </WrapPanel.Resources>
            <CheckBox x:Name="ReadOnlyCheckBox" Content="Read-only"/>
            <CheckBox x:Name="HiddenCheckBox" Content="Hidden"/>
            <CheckBox x:Name="SystemCheckBox" Content="System"/>
            <CheckBox x:Name="ArchiveCheckBox" Content="Archive"/>
        </WrapPanel>
    </GroupBox>
</UserControl>
