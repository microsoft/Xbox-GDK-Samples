        <Files Include="**\*.ttf" />
        <Files Include="**\*.txt" />
        <Files Include="**\*.unity" />
      </DistributionItemGroup>
      <Platform>Gaming.Xbox.XboxOne.x64</Platform>
      <Outlet>$(Outlet_Unity_Public)</Outlet>
      <Owner>Jon Martin (jonmartin@microsoft.com)</Owner>
      <FriendlyURL>https://aka.ms/xgdsamples</FriendlyURL>
      <Description>This sample demonstrates using the Title-Managed Achievements C# API provided by the Unity GDK Wrapper.</Description>
    </FolderDist>

